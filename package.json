{
  "name": "recetario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test-reporter=spec --test \"tests/unidad/*.test.ts\"",
    "test:entorno": "node --env-file=.env.local --import tsx --test-reporter=spec --test \"tests/entorno/*.test.ts\"",
    "test:todo": "npm run test && npm run test:entorno",
    "indices": "node --env-file=.env.local --import tsx scripts/indices.ts",
    "crear-usuario": "node --env-file=.env.local --import tsx scripts/crear-usuario.ts",
    "seed:dev": "node --env-file=.env.local --import tsx scripts/seed-dev.ts",
    "backup": "node --env-file=.env.local --import tsx scripts/backup.ts"
  },
  "dependencies": {
    "@imagekit/next": "^2.1.5",
    "@imagekit/nodejs": "^7.11.0",
    "better-auth": "^1.7.1",
    "mongodb": "^7.5.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
